# AI Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database Configuration
# SQLite default: sqlite:///./data/chatbox.db
# PostgreSQL example: postgresql://user:password@localhost:5432/chatbox
DATABASE_URL=sqlite:///./data/chatbox.db

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Server Configuration
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# RAG & Storage Settings
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./data/uploads
VECTOR_DIR=./data/vectors
